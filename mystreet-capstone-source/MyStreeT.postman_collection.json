    {"name":"Login Admin","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/auth/login","body":{"mode":"raw","raw":"{\n  \"email\": \"admin@mystreet.com\",\n  \"password\": \"admin123\"\n}"}}},
